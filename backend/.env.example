# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables — COPY this to .env and fill in your values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI Multi-Agent Workflow Automation Platform
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true                   # Set to false in production

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ai_workflow_db
# Docker Compose (set automatically by docker-compose.yml):
# DATABASE_URL=postgresql://postgres:changeme@db:5432/ai_workflow_db

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here   # Get from https://aistudio.google.com/
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Development: include the Vite dev server.
# Production:  replace with your real domain(s).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# ── Docker Compose only (PostgreSQL service) ──────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_workflow_db
